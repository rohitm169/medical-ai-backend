{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pip install --upgrade pip && pip install -r requirements.txt",
    "watchPatterns": [
      "**/*.py",
      "requirements.txt",
      "Procfile"
    ]
  },
  "deploy": {
    "startCommand": "gunicorn app:app --bind 0.0.0.0:$PORT --workers 2 --threads 4 --timeout 120 --access-logfile - --error-logfile -",
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "numReplicas": 1,
    "sleepApplication": false
  },
  "environments": {
    "production": {
      "deploy": {
        "startCommand": "gunicorn app:app --bind 0.0.0.0:$PORT --workers 4 --threads 4 --timeout 120 --access-logfile - --error-logfile -"
      }
    }
  }
}